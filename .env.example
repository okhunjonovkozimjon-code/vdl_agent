# Local development and testing settings.
#   cp .env.example .env && chmod 600 .env
# On Railway this file is NOT used: set Variables with the same names instead.
# Comments must stay on their own lines (python-dotenv misreads "KEY=   # comment").

# Bot token from @BotFather (/newbot). Enable Bot Settings -> Business Mode for the bot.
TELEGRAM_BOT_TOKEN=

# Your own numeric Telegram user ID (ask @userinfobot).
OWNER_ID=

# false = PREVIEW mode: replies are only shown in the logs and data/previews.jsonl.
# true  = replies are sent on your behalf.
AUTO_SEND=false

# Output of `claude setup-token` (starts with sk-ant-oat...). Create it once on a computer
# with a browser; it is valid for 1 year. Keep it like a password. Paste it with an editor,
# on ONE line (not with `echo ... >> .env`). This is a subscription token, never an API key.
# If left empty, this machine's own `claude` login is used (local testing only).
CLAUDE_CODE_OAUTH_TOKEN=

# Path to the claude binary. Empty = `claude` on PATH, then ~/.local/bin/claude.
CLAUDE_BIN=

# Model alias or full name (e.g. sonnet, opus). Empty = the CLI default.
CLAUDE_MODEL=

# Reasoning effort: low, medium, high, xhigh, max.
CLAUDE_EFFORT=low

# Seconds to wait for one reply before giving up (minimum 1).
CLAUDE_TIMEOUT_SECONDS=120

# Minutes to wait after hitting the subscription usage limit when the CLI gives no reset time.
LIMIT_COOLDOWN_MINUTES=30

# After you write in a chat yourself, the bot stays quiet there for this many minutes (0 = off).
OWNER_TAKEOVER_MINUTES=15

# Messages kept per chat as conversation context.
HISTORY_LIMIT=30

# VDL Market (Telegram mini app) catalogue search. Paste the key created in the VDL settings window
# exactly as it is. Empty = search is off and no product cards are sent.
VDL_API_KEY=

# VDL search endpoint. Empty = https://vdl-market.lovable.app/api/public/agent/search
VDL_API_URL=

# business = answer your personal chats through Telegram Business (long polling).
# relay    = answer customers who write to the bot itself; the mini app backend (which owns the bot's
#            webhook) forwards those messages to POST /relay. Telegram polling is off in this mode.
AGENT_MODE=business

# Shared secret for POST /relay (relay mode only, at least 24 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_SECRET=

# HTTP port for relay mode. Railway sets PORT automatically.
PORT=8080
